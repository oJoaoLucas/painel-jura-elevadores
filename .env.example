# Copie para .env.local (dev) e configure as MESMAS variáveis na Vercel (produção).
# NUNCA comitar valores reais. Só as NEXT_PUBLIC_* vão pro navegador.

# --- Públicas (vão pro bundle do cliente — leitura/realtime da TV) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# --- Privadas (SÓ no servidor — nunca com prefixo NEXT_PUBLIC) ---
# service_role: usada pelas Server Actions pra gravar no banco. NÃO exponha.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta
# (opcional) URL só do servidor; se ausente, usa a NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# PIN da recepção (verificado no servidor; não vai pro bundle).
ADMIN_PIN=000000

# Segredo pra assinar o cookie de sessão. Gere um valor longo e aleatório, ex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
