# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Encontre em: Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# Senha de acesso da Recepção/Orçamento/Relatório/Config (a TV não pede).
# Defina o mesmo valor também nas variáveis de ambiente da Vercel.
NEXT_PUBLIC_ADMIN_PIN=000000
